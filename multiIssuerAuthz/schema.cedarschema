namespace Acme {
  type Context = {
    current_time?: Long,
    device_health?: Set<String>,
    fraud_indicators?: Set<String>,
    geolocation?: Set<String>,
    network?: String,
    network_type?: String,
    operating_system?: String,
    tokens?: TokensContext,
    user_agent?: String
  };

  type TokensContext = {
    acme_access_token?: Access_token,
    acme_id_token?: id_token,
    acme_userinfo_token?: Userinfo_token,
    total_token_count: Long
  };

  entity Access_token = {
    acr?: __cedar::String,
    amr?: Set<__cedar::String>,
    aud?: __cedar::String,
    azp?: __cedar::String,
    client_id?: __cedar::String,
    exp?: __cedar::Long,
    iat?: __cedar::Long,
    iss?: Acme::TrustedIssuer,
    jti?: __cedar::String,
    nbf?: __cedar::Long,
    nonce?: __cedar::String,
    scope?: Set<__cedar::String>,
    sub?: __cedar::String,
    token_type?: __cedar::String,
    validated_at?: __cedar::Long
  } tags Set<__cedar::String>;

  entity Any;

  entity Application = {
    app_id: String
  };

  entity Role;

  entity TrustedIssuer = {
    issuer_entity_id: Jans::Url
  };

  entity User in [Role] = {
    role: __cedar::String,
    sub: __cedar::String
  };

  entity Userinfo_token = {
    acr?: __cedar::String,
    amr?: Set<__cedar::String>,
    aud?: __cedar::String,
    azp?: __cedar::String,
    client_id?: __cedar::String,
    exp?: __cedar::Long,
    iat?: __cedar::Long,
    iss?: Acme::TrustedIssuer,
    jti?: __cedar::String,
    nbf?: __cedar::Long,
    nonce?: __cedar::String,
    role?: Set<__cedar::String>,
    scope?: Set<__cedar::String>,
    sub?: __cedar::String,
    token_type?: __cedar::String,
    validated_at?: __cedar::Long
  } tags Set<__cedar::String>;

  entity Workload = {
    access_token: Access_token,
    aud: String,
    client_id: String,
    iss: TrustedIssuer
  };

  entity id_token = {
    acr?: __cedar::String,
    amr?: Set<__cedar::String>,
    aud?: __cedar::String,
    azp?: __cedar::String,
    client_id?: __cedar::String,
    exp?: __cedar::Long,
    iat?: __cedar::Long,
    iss?: Acme::TrustedIssuer,
    jti?: __cedar::String,
    nbf?: __cedar::Long,
    nonce?: __cedar::String,
    scope?: Set<__cedar::String>,
    sub?: __cedar::String,
    token_type?: __cedar::String,
    validated_at?: __cedar::Long
  } tags Set<__cedar::String>;

  action "Read" appliesTo {
    principal: [Any],
    resource: [Application],
    context: Context
  };
}

