namespace Jans {
  type Context = {
    current_time?: Long,
    device_health?: Set<String>,
    fraud_indicators?: Set<String>,
    geolocation?: Set<String>,
    network?: String,
    network_type?: String,
    operating_system?: String,
    tokens?: TokensContext,
    user_agent?: String
  };

  type TokensContext = {
    total_token_count: Long
  };

  type Url = {
    host: String,
    path: String,
    protocol: String
  };

  type email_address = {
    domain: String,
    uid: String
  };

  entity Application = {
    app_id: String,
    name: String,
    url: Url
  };

  entity HTTP_Request = {
    header: {
      Accept?: String
    },
    url: Url
  };

  entity Role;
}
